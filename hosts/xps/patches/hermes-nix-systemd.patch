+"""Exercise the actual service functions without Hermes runtime dependencies."""
+
+import ast
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+
+FUNCTIONS = {
+    "_systemd_unit_is_nix_managed",
+    "systemd_unit_is_current",
+    "refresh_systemd_unit_if_needed",
+    "systemd_install",
+    "systemd_uninstall",
+}
+source = ast.parse(Path("hermes_cli/gateway.py").read_text())
+unit = types.ModuleType("gateway")
+unit.Path = Path
+# Compile the real definitions; mock only their runtime collaborators.
+exec(
+    compile(
+        ast.Module(
+            body=[
+                node
+                for node in source.body
+                if isinstance(node, ast.FunctionDef)
+                and node.name in FUNCTIONS
+            ],
+            type_ignores=[],
+        ),
+        "hermes_cli/gateway.py",
+        "exec",
+    ),
+    unit.__dict__,
+)
+
+
+class NixSystemdUnitTests(unittest.TestCase):
+    def setUp(self):
+        self.path = Mock()
+        self.path.resolve.return_value = Path("/nix/store/example/unit.service")
+        self.collaborators = {
+            "get_systemd_unit_path": Mock(return_value=self.path),
+            "_sync_hermes_home_from_systemd_unit": Mock(),
+            "generate_systemd_unit": Mock(),
+            "_run_systemctl": Mock(),
+            "_require_root_for_system_service": Mock(),
+            "_systemd_scope_preamble": Mock(return_value=True),
+        }
+        self.patcher = patch.dict(unit.__dict__, self.collaborators)
+        self.patcher.start()
+        self.addCleanup(self.patcher.stop)
+
+    def test_resolved_store_path_is_managed(self):
+        self.assertTrue(unit._systemd_unit_is_nix_managed(self.path))
+        self.path.resolve.return_value = Path("/nix/store-lookalike/unit.service")
+        self.assertFalse(unit._systemd_unit_is_nix_managed(self.path))
+
+    def test_nix_unit_is_current_without_generating_a_replacement(self):
+        self.assertTrue(unit.systemd_unit_is_current(system=True))
+        unit._sync_hermes_home_from_systemd_unit.assert_called_once_with(
+            system=True
+        )
+        unit.generate_systemd_unit.assert_not_called()
+        self.path.read_text.assert_not_called()
+
+    def test_refresh_never_writes_or_reloads_a_nix_unit(self):
+        self.assertFalse(unit.refresh_systemd_unit_if_needed(system=True))
+        unit._sync_hermes_home_from_systemd_unit.assert_called_once_with(
+            system=True
+        )
+        unit.generate_systemd_unit.assert_not_called()
+        unit._run_systemctl.assert_not_called()
+        self.path.write_text.assert_not_called()
+
+    def test_install_cannot_replace_a_nix_unit_even_with_force(self):
+        unit.systemd_install(system=True, force=True, force_unit_path=True)
+        unit.generate_systemd_unit.assert_not_called()
+        unit._run_systemctl.assert_not_called()
+        self.path.write_text.assert_not_called()
+
+    def test_uninstall_cannot_stop_or_remove_a_nix_unit(self):
+        unit.systemd_uninstall(system=True)
+        unit._run_systemctl.assert_not_called()
+        self.path.unlink.assert_not_called()
+
+    def test_missing_unit_is_not_current_or_refreshed(self):
+        self.path.exists.return_value = False
+        self.assertFalse(unit.systemd_unit_is_current(system=True))
+        self.assertFalse(unit.refresh_systemd_unit_if_needed(system=True))
+        self.path.read_text.assert_not_called()
+        self.path.write_text.assert_not_called()
+        unit._run_systemctl.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
