+"""Standalone regression tests; no Hermes runtime dependencies required."""
+
+import importlib.util
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+spec = importlib.util.spec_from_file_location(
+    "gateway_service_unit", "hermes_cli/gateway_service_unit.py"
+)
+unit = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(unit)
+
+
+class NixSystemdUnitTests(unittest.TestCase):
+    def test_resolved_store_path_is_managed(self):
+        path = Mock()
+        path.resolve.return_value = Path("/nix/store/example/unit.service")
+        self.assertTrue(unit._systemd_unit_is_nix_managed(path))
+        path.resolve.return_value = Path("/nix/store-lookalike/unit.service")
+        self.assertFalse(unit._systemd_unit_is_nix_managed(path))
+
+    def test_nix_unit_is_current_without_generating_a_replacement(self):
+        path = Mock()
+        path.resolve.return_value = Path("/nix/store/example/unit.service")
+        facade = Mock()
+        facade.get_systemd_unit_path.return_value = path
+        with patch.object(unit, "_gw", return_value=facade):
+            self.assertTrue(unit.systemd_unit_is_current(system=True))
+        facade._sync_hermes_home_from_systemd_unit.assert_called_once_with(
+            system=True
+        )
+        facade.generate_systemd_unit.assert_not_called()
+        path.read_text.assert_not_called()
+
+    def test_refresh_never_writes_or_reloads_a_nix_unit(self):
+        path = Mock()
+        path.resolve.return_value = Path("/nix/store/example/unit.service")
+        facade = Mock()
+        facade.get_systemd_unit_path.return_value = path
+        with patch.object(unit, "_gw", return_value=facade):
+            self.assertFalse(unit.refresh_systemd_unit_if_needed(system=True))
+        facade._sync_hermes_home_from_systemd_unit.assert_called_once_with(
+            system=True
+        )
+        facade.generate_systemd_unit.assert_not_called()
+        facade._run_systemctl.assert_not_called()
+        path.write_text.assert_not_called()
+
+    def test_native_units_can_still_be_refreshed(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "hermes-gateway.service"
+            path.write_text("old unit")
+            facade = Mock()
+            facade.get_systemd_unit_path.return_value = path
+            facade.systemd_unit_is_current.return_value = False
+            facade.generate_systemd_unit.return_value = "new unit"
+            facade._refuse_temp_home_service_write.return_value = False
+            with patch.object(unit, "_gw", return_value=facade):
+                self.assertTrue(
+                    unit.refresh_systemd_unit_if_needed(system=True)
+                )
+            self.assertEqual(path.read_text(), "new unit")
+            facade._run_systemctl.assert_called_once_with(
+                ["daemon-reload"], system=True, check=True, timeout=30
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
